# PWRI Plant Monitoring — Environment Variables
#
# Copy this file to .env.local and fill in your Supabase project values.
# NEVER commit .env.local — it is gitignored.
#
# To find these values: Supabase Dashboard → Project Settings → API

# ── Required ──────────────────────────────────────────────────────────────────

# Your Supabase project URL (e.g. https://abcdefghijkl.supabase.co)
VITE_SUPABASE_URL=

# Your Supabase anon (public) key — safe to expose in the browser
VITE_SUPABASE_PUBLISHABLE_KEY=

# ── Optional ──────────────────────────────────────────────────────────────────

# Used by `npm run types:gen` to regenerate src/integrations/supabase/types.ts
# Find this in Supabase Dashboard → Project Settings → General → Reference ID
VITE_SUPABASE_PROJECT_ID=

# Sentry DSN for error monitoring (leave blank to disable Sentry)
VITE_SENTRY_DSN=
VITE_SENTRY_ENV=development

# Client logging verbosity: debug | info | warn | error (default: info)
VITE_LOG_LEVEL=info

# Optional remote endpoint to stream operational audit logs
VITE_AUDIT_LOG_ENDPOINT=
