# Supabase Configuration (required)
# Get these from your Supabase project settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# Error monitoring (optional — see src/lib/monitoring.ts)
# Create a free Sentry project at https://sentry.io, copy its DSN here.
# When unset, monitoring is a safe console-only no-op (never an error).
VITE_SENTRY_DSN=
# Environment label for Sentry (defaults to Vite's MODE when unset).
VITE_SENTRY_ENV=

# Staging (optional — see docs/STAGING.md)
# Vercel preview deployments point at the staging Supabase project by
# setting these three vars to the STAGING project's values in the Vercel
# dashboard (Project → Settings → Environment Variables → Preview scope).
# Nothing in the codebase reads these; they exist so the preview env block
# is documented next to the production one.

