# PWRI Plant Monitoring — Environment Variables
#
# Copy this file to .env.local and fill in your Supabase project values.
# NEVER commit .env.local — it is gitignored.
#
# To find these values: Supabase Dashboard → Project Settings → API

# ── Required ──────────────────────────────────────────────────────────────────

# Your Supabase project URL (e.g. https://abcdefghijkl.supabase.co)
VITE_SUPABASE_URL=

# Your Supabase anon (public) key — safe to expose in the browser
VITE_SUPABASE_PUBLISHABLE_KEY=

# ── Optional ──────────────────────────────────────────────────────────────────

# Used by `npm run types:gen` to regenerate src/integrations/supabase/types.ts
# Find this in Supabase Dashboard → Project Settings → General → Reference ID
VITE_SUPABASE_PROJECT_ID=

# Web Push (VAPID) public key — REQUIRED for push notifications to work.
# Generate a pair with: node scripts/generate-vapid-keys.mjs
# The matching VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY must be set as Edge Function
# secrets, or every push is rejected by the push service. See DEPLOYMENT.md.
# When this is unset/invalid the Profile page reports "Not Configured" and the
# push toggle is disabled, rather than silently creating an undeliverable
# subscription.
VITE_VAPID_PUBLIC_KEY=

# ── Staging ───────────────────────────────────────────────────────────────────
#
# Staging uses the SAME variable names as production — only the values differ
# per deploy scope (e.g. Vercel project / environment settings). There are no
# separate STAGING_* variables anywhere in the codebase. Values are baked in at
# Vite build time, so after changing a scope value you must redeploy.
# See docs/STAGING.md and docs/STAGING_SETUP.md.

# Sentry DSN for error monitoring (leave blank to disable Sentry)
VITE_SENTRY_DSN=
VITE_SENTRY_ENV=development

# Client logging verbosity: debug | info | warn | error (default: info)
VITE_LOG_LEVEL=info

# Optional remote endpoint to stream operational audit logs
VITE_AUDIT_LOG_ENDPOINT=
