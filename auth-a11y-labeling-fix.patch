From 1ab4ac3244d0ca5dfdaf7f869d94e988aca89fc2 Mon Sep 17 00:00:00 2001
From: Claude <assistant@anthropic.local>
Date: Sun, 16 Aug 2026 21:03:42 +0000
Subject: [PATCH] a11y: wire up label/control association across Auth.tsx +
 gate it in CI

- Auth.tsx: every Label/Input pair (sign-in, forgot-password, OTP reset,
  and all sign-up steps incl. dynamically-indexed operator rows) now has
  a matching id/htmlFor. Previously all of these reached screen readers
  as an unnamed 'edit text' -- this is the first screen every user hits.
- DesignationCombobox.tsx: added an optional id prop, forwarded to the
  trigger button, with an aria-label fallback when unset, so any call
  site can now be labeled (not just Auth.tsx's usage).
- eslint.config.js: added jsx-a11y, scoped to label-has-associated-control
  only (not the full recommended config). Mapped the shadcn Label
  component to 'label' via settings so the rule actually sees the ~430
  custom-component uses instead of only the 46 native <label> tags.
- lint-ceiling.json: honestly reconciled to 2094 (1723 + 371 newly
  surfaced, pre-existing label warnings across 57 other files). Tracked
  as a shrinking budget going forward, same convention already used for
  no-explicit-any -- this PR fixes Auth.tsx (0 of the 371) and gates
  everything else from getting worse.

Verified: tsc --noEmit clean, eslint --max-warnings 2094 passes with 0
errors, npm run build succeeds.
---
 frontend/eslint.config.js                     |   21 +
 frontend/lint-ceiling.json                    |   10 +-
 frontend/package-lock.json                    | 1749 ++++++++++++++++-
 frontend/package.json                         |    1 +
 .../src/components/DesignationCombobox.tsx    |    6 +-
 frontend/src/pages/Auth.tsx                   |   56 +-
 6 files changed, 1747 insertions(+), 96 deletions(-)

diff --git a/frontend/eslint.config.js b/frontend/eslint.config.js
index 1847e003..bb983d43 100644
--- a/frontend/eslint.config.js
+++ b/frontend/eslint.config.js
@@ -2,6 +2,7 @@ import js from "@eslint/js";
 import globals from "globals";
 import reactHooks from "eslint-plugin-react-hooks";
 import reactRefresh from "eslint-plugin-react-refresh";
+import jsxA11y from "eslint-plugin-jsx-a11y";
 import tseslint from "typescript-eslint";
 
 export default tseslint.config(
@@ -16,6 +17,16 @@ export default tseslint.config(
     plugins: {
       "react-hooks": reactHooks,
       "react-refresh": reactRefresh,
+      "jsx-a11y": jsxA11y,
+    },
+    settings: {
+      // Without this, jsx-a11y/label-has-associated-control only sees the
+      // 46 native <label> tags in the codebase and silently ignores all
+      // ~430 uses of the shadcn <Label> wrapper (src/components/ui/label.tsx,
+      // which renders @radix-ui/react-label -> a real <label> under the
+      // hood) -- i.e. it would miss almost the entire problem this rule
+      // was added to catch.
+      "jsx-a11y": { components: { Label: "label" } },
     },
     rules: {
       ...reactHooks.configs.recommended.rules,
@@ -28,6 +39,16 @@ export default tseslint.config(
       // instead of hard-blocking every PR. New `any` usage should still be
       // avoided — this is a ratchet, not a blanket allowance.
       "@typescript-eslint/no-explicit-any": "warn",
+      // Added 2026-08-17 after an audit found 431 shadcn <Label> uses vs.
+      // only 15 wired to their control via htmlFor/id -- most fields were
+      // reaching screen readers as an unnamed "edit text". Auth.tsx (the
+      // first screen every user hits) is fixed as of this commit; the
+      // remaining count below is pre-existing debt in other forms, tracked
+      // the same way as no-explicit-any: a shrinking budget, not a license
+      // to add more. Scoped to this one rule rather than jsx-a11y's full
+      // recommended config, which would add several unreviewed rules and
+      // an unknown warning count in the same PR as an unrelated fix.
+      "jsx-a11y/label-has-associated-control": "warn",
     },
   },
 );
